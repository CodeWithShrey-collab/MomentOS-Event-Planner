# Copy into your local environment manager; never commit .env or credentials.
APP_ENV=development
APP_BASE_URL=http://127.0.0.1:5000
SECRET_KEY=replace-with-a-random-32-byte-or-longer-value
DATABASE_URL=sqlite:///momentos.sqlite3
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
SESSION_TTL_DAYS=30
SESSION_ABSOLUTE_TTL_DAYS=180

# `demo` is deterministic and makes no provider requests. Use `live` only with an authorized key.
AI_MODE=demo
OPENAI_API_KEY=
VITE_MOMENTOS_MODE=live
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=3000
OPENAI_TIMEOUT_SECONDS=25
AI_DAILY_REQUEST_LIMIT=20
AI_PER_MINUTE_LIMIT=5

# Live usage estimates use versioned USD-per-million-token rates. Current documented GPT-6 Luna
# short-context standard rates are input $0.05/M, cached input $0.005/M, output $0.25/M.
AI_PRICING_CONFIG_VERSION=openai-gpt-6-luna-2026-10-22-v1
AI_INPUT_USD_PER_MILLION=0.05
AI_CACHED_INPUT_USD_PER_MILLION=0.005
AI_OUTPUT_USD_PER_MILLION=0.25

# Use a shared Redis-compatible store for production Flask-Limiter workers.
RATE_LIMIT_STORAGE_URI=memory://
TRUSTED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
# Keep zero for direct local development. Set exact trusted proxy counts only in deployment.
PROXY_FIX_X_FOR=0
PROXY_FIX_X_PROTO=0
PROXY_FIX_X_HOST=0
MAX_CONTENT_LENGTH=262144
MAX_TASKS_PER_EVENT=500
MAX_SCENARIOS=3
